{
  "name": "@ohos-rs/arkdown",
  "version": "0.1.3",
  "description": "Node.js bindings for arkdown — OHOS build tool with Rolldown-aligned plugin support",
  "main": "js/runtime-entry.js",
  "types": "runtime-entry.d.ts",
  "bin": {
    "arkdown": "js/arkdown-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richerfu/arkdown.git",
    "directory": "packages/arkdown"
  },
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "ohos",
    "harmonyos",
    "arkdown",
    "napi-rs",
    "rolldown",
    "bundler"
  ],
  "files": [
    "js/",
    "index.d.ts",
    "index.js",
    "runtime-entry.d.ts",
    "README.md",
    "tsrs-LICENSE.txt",
    "tsrs-NOTICE.txt",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "scripts/package-licenses.cjs",
    "NOTICE"
  ],
  "napi": {
    "binaryName": "arkdown",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18.17.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "artifacts": "napi artifacts && node scripts/package-licenses.cjs",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node scripts/package-licenses.cjs && node --test",
    "test:e2e": "node --test __test__/*.e2e.cjs",
    "smoke": "node -e \"const arkdown = require('./js/runtime-entry.js'); if (typeof arkdown.build !== 'function') process.exit(1)\" && node js/arkdown-cli.js --help",
    "publish:local": "bash scripts/publish-local.sh",
    "lint": "oxlint --deny-warnings js __test__ scripts",
    "lint:fix": "oxlint --fix js __test__ scripts",
    "format": "cd ../.. && oxfmt packages/arkdown/js packages/arkdown/__test__ packages/arkdown/scripts packages/arkdown/package.json packages/arkdown/index.d.ts packages/arkdown/runtime-entry.d.ts packages/arkdown/.oxlintrc.json .github .oxfmtrc.json",
    "format:check": "cd ../.. && oxfmt --check packages/arkdown/js packages/arkdown/__test__ packages/arkdown/scripts packages/arkdown/package.json packages/arkdown/index.d.ts packages/arkdown/runtime-entry.d.ts packages/arkdown/.oxlintrc.json .github .oxfmtrc.json",
    "format:rs": "cargo fmt",
    "prepublishOnly": "napi prepublish -t npm",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "licenses": "node scripts/package-licenses.cjs",
    "prepack": "node scripts/package-licenses.cjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "packageManager": "pnpm@10.12.1"
}
