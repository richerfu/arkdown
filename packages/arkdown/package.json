{
  "name": "@ohos-rs/arkdown",
  "version": "0.0.1-beta.11",
  "description": "Node.js bindings for arkdown — OHOS build tool with Rolldown-aligned plugin support",
  "main": "js/runtime-entry.js",
  "types": "runtime-entry.d.ts",
  "bin": {
    "arkdown": "js/arkdown-cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richerfu/arkdown.git",
    "directory": "packages/arkdown"
  },
  "license": "UNLICENSED",
  "keywords": [
    "ohos",
    "harmonyos",
    "arkdown",
    "napi-rs",
    "rolldown",
    "bundler"
  ],
  "files": [
    "js/",
    "index.d.ts",
    "index.js",
    "runtime-entry.d.ts",
    "README.md"
  ],
  "napi": {
    "binaryName": "arkdown",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "engines": {
    "node": ">= 18.17.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test",
    "smoke": "node -e \"const arkdown = require('./js/runtime-entry.js'); if (typeof arkdown.build !== 'function') process.exit(1)\" && node js/arkdown-cli.js --help",
    "publish:local": "bash scripts/publish-local.sh",
    "format": "prettier . -w",
    "format:rs": "cargo fmt",
    "prepublishOnly": "napi prepublish -t npm",
    "preversion": "napi build --platform && git add .",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.1",
    "prettier": "^3.6.2"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "pnpm@10.12.1"
}
