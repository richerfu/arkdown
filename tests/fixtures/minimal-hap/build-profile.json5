{
  app: {
    products: [
      {
        name: "default",
        signingConfig: "default",
        compileSdkVersion: "5.0.0(12)",
        compatibleSdkVersion: "5.0.0(12)",
        runtimeOS: "HarmonyOS",
        bundleName: "com.example.arkdown.test",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: false,
            useNormalizedOHMUrl: false
          }
        }
      }
    ]
  },
  modules: [
    {
      name: "entry",
      srcPath: "./entry",
      targets: [
        {
          name: "default",
          applyToProducts: ["default"]
        }
      ]
    }
  ]
}
