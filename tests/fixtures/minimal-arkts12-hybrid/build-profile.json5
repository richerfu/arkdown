{
  app: {
    signingConfigs: [],
    products: [
      {
        name: "default",
        compileSdkVersion: "26",
        targetSdkVersion: "26",
        compatibleSdkVersion: "23",
        runtimeOS: "OpenHarmony",
        arkTSVersion: "1.2",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true
          }
        }
      }
    ],
    buildModeSet: [
      { name: "debug" },
      { name: "release" }
    ]
  },
  modules: [
    {
      name: "entry",
      srcPath: "./entry",
      targets: [
        {
          name: "default",
          applyToProducts: ["default"]
        }
      ]
    }
  ]
}
