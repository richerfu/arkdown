#!/bin/bash
# hvigorw replacement that runs the DevEco-bundled hvigor engine directly.
#
# The bundled wrapper tries to pnpm-install @ohos/hvigor from public npm
# registries, which does not exist; the DevEco IDE provisions the packages
# itself. This script provisions the per-project workspace the same way
# (symlinks into ~/.hvigor/project_caches/<hash>/workspace) and runs
# the engine in-process, bypassing the wrapper's install phase.
#
# Workspace hash: the engine's `calProjectCacheDir` computes
# sha256(path.resolve(cwd))[:32]. node's process.cwd() is the OS-level
# physical path (/private/tmp/...), so use `pwd -P` and SHA-256, not the
# logical path or md5.
#
# Usage:
#   ARKDOWN_PARITY_HVIGORW="$PWD/hvigor/tools/arkdown-hvigorw" \
#   ARKDOWN_PARITY_RUN=1 cargo test -p arkdown-napi --test hvigor_parity
#
# Override DEVECO_APP to point at another DevEco Studio installation.

set -e

DEVECO_APP="${DEVECO_APP:-/Applications/DevEco-Studio.app}"
HVIGOR_ROOT="${DEVECO_APP}/Contents/tools/hvigor"
SDK_ROOT="${DEVECO_APP}/Contents/sdk"
export DEVECO_SDK_HOME="${DEVECO_SDK_HOME:-${SDK_ROOT}}"
export OHOS_SDK_HOME="${OHOS_SDK_HOME:-${SDK_ROOT}/default/openharmony}"

# The plugin resolves `@ohos/hvigor` from its own node_modules; the IDE's
# normal install links the engine in. Mirror that here (idempotent).
PLUGIN_ENGINE_LINK="${HVIGOR_ROOT}/hvigor-ohos-plugin/node_modules/@ohos/hvigor"
mkdir -p "$(dirname "${PLUGIN_ENGINE_LINK}")"
[ -e "${PLUGIN_ENGINE_LINK}/package.json" ] || ln -sfn ../../../hvigor "${PLUGIN_ENGINE_LINK}"

# calProjectCacheDir: sha256(pwd -P)[0..32] under ~/.hvigor/project_caches
HASH="$(printf '%s' "$(pwd -P)" | shasum -a 256 | cut -c1-32)"
WS="${HOME}/.hvigor/project_caches/${HASH}/workspace"

mkdir -p "${WS}/node_modules/@ohos"
ln -sfn "${HVIGOR_ROOT}/hvigor" "${WS}/node_modules/@ohos/hvigor"
ln -sfn "${HVIGOR_ROOT}/hvigor-ohos-plugin" "${WS}/node_modules/@ohos/hvigor-ohos-plugin"
ln -sfn "${HVIGOR_ROOT}/hvigor/node_modules/@ohos/hvigor-common" "${WS}/node_modules/@ohos/hvigor-common"
ln -sfn "${HVIGOR_ROOT}/hvigor/node_modules/@ohos/hvigor-logger" "${WS}/node_modules/@ohos/hvigor-logger"

exec node "${HVIGOR_ROOT}/hvigor/bin/hvigor.js" "$@"
